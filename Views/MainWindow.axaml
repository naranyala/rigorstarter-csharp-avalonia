<Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:RigorStarter.ViewModels"
         xmlns:comp="using:RigorStarter.Components"
         x:Class="RigorStarter.Views.MainWindow"
         x:DataType="vm:MainWindowViewModel"
         x:Name="RootWindow"
         Title="RigorStarter Avalonia"
         Width="800" Height="600"
         WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit" />
            <MenuItem Header="_View" />
            <MenuItem Header="_Help" />
        </Menu>

        <!-- Top Navbar -->
        <Border Grid.Row="1" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15">
            <Grid ColumnDefinitions="*, Auto">
                <Button Command="{Binding GoToDashboardCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center">
                    <TextBlock Text="RigorStarter App" 
                               Foreground="{DynamicResource PrimaryText}" 
                               FontSize="20" 
                               FontWeight="Bold" />
                </Button>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="🔍 Search" 
                            Command="{Binding ToggleSearchCommand}"
                            Background="Transparent"
                            Foreground="{DynamicResource PrimaryText}"
                            BorderThickness="0"/>
                    
                    <Button Content="{Binding IsDarkTheme, Converter={StaticResource ThemeIconConverter}}" 
                            Command="{Binding ToggleThemeCommand}"
                            Background="Transparent"
                            Foreground="{DynamicResource PrimaryText}"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Panel Grid.Row="2">
            <ScrollViewer>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30" Margin="20">
                    <!-- Dashboard View -->
                    <StackPanel Spacing="10" IsVisible="{Binding !IsAnyItemSelected}">
                        <TextBlock Text="Welcome to Component Dashboard" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalItems, StringFormat='You have {0} items available'}" 
                                   FontSize="16"
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Pinned" FontSize="18" FontWeight="SemiBold" Foreground="#2196F3"/>
                        <ItemsControl ItemsSource="{Binding PinnedItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="|" Foreground="{DynamicResource SecondaryText}" />
                                        <TextBlock Text="{Binding LinesOfCode, StringFormat='{}{0} lines'}" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,10" />

                        <TextBlock Text="In Development" FontSize="18" FontWeight="SemiBold" Foreground="#FF9800"/>
                        <ItemsControl ItemsSource="{Binding InDevelopmentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="|" Foreground="{DynamicResource SecondaryText}" />
                                        <TextBlock Text="{Binding LinesOfCode, StringFormat='{}{0} lines'}" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,10" />

                        <TextBlock Text="Archives" FontSize="18" FontWeight="SemiBold" Foreground="#757575"/>
                        <ItemsControl ItemsSource="{Binding ArchivesItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="|" Foreground="{DynamicResource SecondaryText}" />
                                        <TextBlock Text="{Binding LinesOfCode, StringFormat='{}{0} lines'}" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Item Detail View -->
                    <StackPanel Spacing="10" Width="600" IsVisible="{Binding IsAnyItemSelected}">
                        <comp:Accordion IsVisible="{Binding IsAccordionSelected}" />
                        <comp:Drawer IsVisible="{Binding IsDrawerSelected}" />
                        <comp:Card IsVisible="{Binding IsCardSelected}" />
                        <comp:Button IsVisible="{Binding IsButtonSelected}" />
                        <comp:Tabs IsVisible="{Binding IsTabsSelected}" />
                        <comp:MetricCard IsVisible="{Binding IsMetricCardSelected}" />
                        <comp:TodoList IsVisible="{Binding IsTodoListSelected, ElementName=RootWindow, Path=DataContext.IsTodoListSelected}" x:CompileBindings="False" />
                        <comp:TodoListJson IsVisible="{Binding IsTodoListJsonSelected, ElementName=RootWindow, Path=DataContext.IsTodoListJsonSelected}" x:CompileBindings="False" />
                        <comp:TreeViewDemo IsVisible="{Binding IsTreeViewDemoSelected, ElementName=RootWindow, Path=DataContext.IsTreeViewDemoSelected}" x:CompileBindings="False" />
                        <comp:TableData IsVisible="{Binding IsTableDataSelected, ElementName=RootWindow, Path=DataContext.IsTableDataSelected}" x:CompileBindings="False" />
                        <comp:MarkdownDemo IsVisible="{Binding IsMarkdownDemoSelected, ElementName=RootWindow, Path=DataContext.IsMarkdownDemoSelected}" x:CompileBindings="False" />
                        
                        <Border IsVisible="{Binding IsUtilitySelected}" 

                                Background="{DynamicResource SurfaceBackground}" 
                                CornerRadius="5" 
                                Padding="15" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1">
                            <StackPanel Spacing="15">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Source Code" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                                    <Border Background="{DynamicResource AppBackground}" CornerRadius="4" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedItem.SourceCode}" 
                                                    FontFamily="Courier New" 
                                                    FontSize="12" 
                                                    TextWrapping="Wrap" 
                                                    Foreground="{DynamicResource PrimaryText}" />
                                    </Border>
                                </StackPanel>
                                
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Execution Result" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                                    <Border CornerRadius="4" Padding="10" BorderThickness="1">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}"/>
                                            </Style>
                                            <Style Selector="Border[IsVisible=False]">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Style>
                                        </Border.Styles>
                                        <TextBlock Text="{Binding SelectedItem.ResultText}" 
                                                    FontFamily="Courier New" 
                                                    FontSize="12" 
                                                    TextWrapping="Wrap" 
                                                    Foreground="{DynamicResource SuccessText}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="This component is still in development!" 
                                   FontSize="16" 
                                   Foreground="{DynamicResource SecondaryText}" 
                                   HorizontalAlignment="Center" 
                                   IsVisible="{Binding IsMockupSelected}"
                                   Margin="0,20,0,0"
                                   FontStyle="Italic" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border IsVisible="{Binding IsSearchPanelOpen}" 
                    Background="#CC000000" 
                    ZIndex="100">
                <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="0"
                             Text="{Binding SearchText, Mode=TwoWay}" 
                             Watermark="Search..." 
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" Margin="0,10">
                        <ItemsControl ItemsSource="{Binding FilteredItems}" x:CompileBindings="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchItemViewModel">
                                    <Button Command="{Binding $parent[Window].DataContext.SelectItemCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Close" 
                            Command="{Binding ToggleSearchCommand}" 
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Panel>
    </Grid>
</Window>



