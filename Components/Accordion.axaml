<UserControl xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:RigorStarter.ViewModels"
               x:Class="RigorStarter.Components.Accordion"
               x:DataType="vm:MainWindowViewModel">
    
    <ItemsControl ItemsSource="{Binding AccordionItems}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AccordionItemViewModel">
                <Expander Header="{Binding Header}" 
                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                          Margin="0,0,0,5">
                    <TextBlock Text="{Binding Content}" 
                               TextWrapping="Wrap" 
                               Margin="10,5" />
                </Expander>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
