<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:RigorStarter.Components"
             xmlns:vm="using:RigorStarter.ViewModels"
             x:Class="RigorStarter.Components.MetricCard"
             x:DataType="vm:MetricCardViewModel">
    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel Spacing="10">
            <DockPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SecondaryText}" DockPanel.Dock="Left"/>
                <comp:StatusBadge Status="{Binding Status}" DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Text="{Binding Trend}" FontSize="12" Foreground="Green" FontWeight="SemiBold" />
        </StackPanel>
    </Border>
</UserControl>
